{
  "name": "cav-self",
  "version": 2,
  "description": "Reconcile two independent implementations of CAV v2 (this tool), one per agent.",
  "repo": {
    "host": "C:\\Users\\richa\\Documents\\Default Project\\cross-agent-validation",
    "secondary": "C:\\Users\\richa\\Desktop\\Kimi\\cross-agent-validation",
    "branch": "main"
  },
  "agents": {
    "deepseek": {
      "kind": "opencode",
      "model": "deepseek/deepseek-flash#high",
      "bootstrap_ref": "HEAD"
    },
    "kimi": {
      "kind": "kimi",
      "model": "kimi-code/k3.1-pro",
      "thinking": "high",
      "bootstrap_exclude": ["docs/PROPOSAL*"]
    }
  },
  "checks": [
    "{python} -m unittest discover -s tests -t ."
  ],
  "convergence": "functional",
  "canonical_agent": "deepseek",
  "strict_paths": [],
  "formatter": null,
  "carry_forward_limit": 20,
  "max_rounds": 4,
  "round_seconds": 5400,
  "stall_seconds": 1200,
  "poll_seconds": 15,
  "retries": 1
}
